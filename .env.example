# --- Example file for environment variables (make env copies it to .env; skipped if .env exists) (DOCKER.md §3) ---

# --- CPU type (default linux/arm64 for Apple Silicon; linux/amd64 on an x64 PC) (DOCKER.md §1) ---
# PLATFORM=linux/arm64

# --- Determinism of numerical computation (DOCKER.md §3) ---
# OMP_NUM_THREADS=1
# OPENBLAS_NUM_THREADS=1
# MKL_NUM_THREADS=1

# --- Container time zone (default Asia/Tokyo; do not change it partway) (DOCKER.md §3) ---
# CONTAINER_TZ=Asia/Tokyo

# --- Names of settings the project adds (Layers 4–5 extension point; leave values empty here and write them in .env) (LAYERS.md "Extension points for Layers 4–5") ---
