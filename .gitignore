# --- Things Git does not track (WORKSPACE.md §1) ---

# --- Secrets (WORKSPACE.md §1) ---
.env.*
*.env
!.env.example
.Renviron
.httr-oauth
*.pem
*.key
secrets.yaml
secrets.yml
.Rhistory
.RDataTmp*
.Ruserdata

# --- Data (keep only .gitkeep and README.md) (WORKSPACE.md §1) ---
data/**
!data/**/
!data/**/.gitkeep
!data/README.md

# --- Outputs (keep only .gitkeep) (WORKSPACE.md §1) ---
models/**
!models/.gitkeep
outputs/**
!outputs/**/
!outputs/**/.gitkeep

# --- Documents rendered in notebooks/, and working files and caches made while rendering (WORKSPACE.md §1) ---
notebooks/**/*.html
notebooks/**/*_files/
notebooks/**/*.pdf
notebooks/**/*.tex
notebooks/**/*.rmarkdown
notebooks/**/*.knit.md
notebooks/**/*_cache/
notebooks/**/.quarto
notebooks/**/.gitignore

# --- Word documents (WORKSPACE.md §1) ---
*.docx

# --- Raw data file extensions (WORKSPACE.md §1) ---
*.sav
*.zsav
*.por
*.rds
*.rda
*.RData
*.fst
*.qs2
*.dta
*.sas7bdat
*.xpt
*.parquet
*.feather
*.arrow
*.xlsx
*.xls
*.xlsm
*.dbf
*.accdb
*.mdb
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.csv
*.tsv

# --- Exception: tracked as evidence for reproducibility (WORKSPACE.md §1) ---
!docs/definition/*.csv

# --- Audio and video file extensions (WORKSPACE.md §1) ---
*.m4a
*.mp4
*.wav
*.mp3
*.flac
*.aac
*.ogg
*.mov
*.mkv
*.webm
*.aiff
*.aif

# --- Files created by R and RStudio (WORKSPACE.md §1) ---
.Rproj.user/
*.Rproj
Rplots.pdf

# --- Per-machine settings (WORKSPACE.md §1) ---
.claude/
.vscode/*

# --- Exception: VS Code settings distributed by the template (WORKSPACE.md §1) ---
!.vscode/settings.json

# --- Files created by the OS and editors (WORKSPACE.md §1) ---
.DS_Store
*.swp

# --- The record of the template's decisions (kept only on the maintainer's computer; not in Git or the distributed Zip) (LAYERS.md "Pulling in template updates") ---
docs/TEMPLATE_CHANGELOG.md

# --- Lines added by the project (extension point for Layers 4–5) (LAYERS.md "Extension points for Layers 4–5") ---
